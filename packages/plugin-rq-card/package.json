{
  "name": "@01men/plugin-rq-card",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "01门 会话侧注入插件（WP-06 演进）：四态执行卡片 + 👍/👎 反馈条 + 连接宿主向导，dsh.client 双面插件（浏览器半经 /plugins/<id>/client.js 下发）",
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs"
  }
}
