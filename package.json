{
  "name": "dsh-enterprise-ops",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "企业 AI 资源统一管理平台 —— 基于 DeepSeek Harness「一切皆插件」架构",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/01men/RQ-DSH.git"
  },
  "files": [
    "cordis.patch.yml",
    "cordis.yml",
    "packages",
    "src",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.7 <0.2.0",
      "dshReleases": {
        "0.1.0-rc.7": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "start": "node src/main.ts",
    "selftest": "node tests/selftest.mjs",
    "lint:manifests": "node scripts/lint-manifests.mjs",
    "manifests": "node scripts/gen-manifests.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "jsdom": "^30.0.1",
    "openid-client": "^6.8.7"
  }
}
